{
  "name": "host-telemetry-mcp",
  "version": "1.1.0",
  "description": "Single source of truth for host CPU/memory/disk/GPU/systemd telemetry. Exposes an MCP stdio server, an HTTP/JSON mode, and a library entry point.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitals": {
      "types": "./dist/lib/vitals.d.ts",
      "default": "./dist/lib/vitals.js"
    },
    "./sampler": {
      "types": "./dist/lib/sampler.d.ts",
      "default": "./dist/lib/sampler.js"
    },
    "./parsers": {
      "types": "./dist/lib/parsers.d.ts",
      "default": "./dist/lib/parsers.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "host-telemetry-mcp": "./dist/bin/mcp.js",
    "host-telemetry-http": "./dist/bin/http.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/bin/mcp.js dist/bin/http.js",
    "start": "node dist/bin/mcp.js",
    "start:http": "node dist/bin/http.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "pretest": "tsc"
  },
  "author": "DRNZY",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
